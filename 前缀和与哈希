#include <iostream>
#include<algorithm>
#include<unordered_map>
using namespace std;
const int N = 1e5 + 10; 
int arr[N] = { 0 };
unordered_map<int, int> mp;
int sum = 0;
int tep[N] = {0};
int main() {
	int t,ans = 0;
	cin >> t;
	mp[0] = 0;
	for (int i = 0; i < t; i++) {
		cin >> arr[i];
		if (arr[i] == 0) sum--;
		else sum++;
		if (mp.count(sum)) {
			ans = max(ans, i+1 - mp[sum]);
		}
		else mp[sum] = i+1;
	}
	cout << ans << endl;

	return 0;
}
