#include <iostream>
#include<algorithm>
#include<cmath>
#include<cstring>
using namespace std;
const int N = 210;
int arr[N] = {0};
int tem[N] = {0};
int main() {
	int t;
	cin >> t;
	for (int i = 1; i <= t; i++) {
		cin >> arr[i];
	}
	memset(tem, 0x3f, sizeof(tem));
	tem[1] = 0;
	for (int i = 2; i <= t; i++) {
		if (arr[i] == arr[i - 1] + 1) tem[i] = tem[i - 1] + 1;
 		for (int j = 1; j < i; j++) {
			int k = i - j;
			long long maxh = arr[j] + (1LL << k);
			if (arr[i] <= maxh) {
				if (tem[j + k] != 0x3f3f3f3f) {
					tem[i] = min(tem[i], tem[j + k] + k + 1);
				}
			}
		}
	}
	if (tem[t] == N) cout << -1 << endl;
	else cout << tem[t] << endl;
	return 0;
}
